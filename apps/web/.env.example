# HttpApiEndpoint output of the SAM stack (stage $default, no /v1 suffix).
VITE_API_URL=http://localhost:3001
VITE_AWS_REGION=ap-southeast-1
# UserPoolId and UserPoolClientId outputs of the SAM stack.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# true = show labelled sample data when the API is unreachable. Always on under `vite dev`.
VITE_ENABLE_MOCK_DATA=false
# Role of the sample profile while testing permissions locally: admin, analyst or viewer.
VITE_MOCK_ROLE=admin
